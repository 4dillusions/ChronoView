<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:App4di.Dotnet.ChronoView.AvaloniaUI.Controls"
             xmlns:conv="clr-namespace:App4di.Dotnet.ChronoView.AvaloniaUI.Converters"
             xmlns:loc="clr-namespace:App4di.Dotnet.ChronoView.AvaloniaUI.Localization"
             xmlns:vm="clr-namespace:App4di.Dotnet.ChronoView.Infrastructure.ViewModel;assembly=App4di.Dotnet.ChronoView.Infrastructure"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="App4di.Dotnet.ChronoView.AvaloniaUI.View.HomeView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Resources>
        <conv:IntToGridLengthConverter x:Key="IntToGridLengthConverter"/>
        <conv:BoolToPlayPauseTextConverter x:Key="BoolToPlayPauseTextConverter"/>
        <conv:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto"
          RowSpacing="0">

        <!-- Image view -->
        <Border Grid.Row="0"
                Margin="8"
                CornerRadius="12"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="*,Auto">

                <!-- Image -->
                <ScrollViewer x:Name="ImageScroller"
                              Grid.Row="0"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="ImageViewportHost"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <LayoutTransformControl x:Name="ImageRotateHost"
                                                UseRenderTransform="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <RotateTransform Angle="0"/>
                                </TransformGroup>
                            </LayoutTransformControl.LayoutTransform>
                            <Image x:Name="ImageView"
                                   Stretch="Uniform"
                                   RenderTransformOrigin="0.5,0.5"
                                   Source="{Binding SelectedImageItem.ImagePath, Converter={StaticResource ImagePathToBitmapConverter}}"/>
                        </LayoutTransformControl>
                    </Grid>
                </ScrollViewer>

                <!-- Menu -->
                <Border Grid.Row="1"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource App.SurfaceBorderBrush}"
                        Background="{DynamicResource App.SurfaceBrush}"
                        Padding="10,8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button ToolTip.Tip="{loc:Tr Cmd_OpenFolder.Label}"
                                Command="{Binding OpenFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🗂️"/>
                                <TextBlock Text="{loc:Tr Cmd_OpenFolder.Label}"/>
                            </StackPanel>
                        </Button>
                        <Separator Width="1"/>

                        <Button ToolTip.Tip="{loc:Tr Cmd_Back.Label}"
                                Command="{Binding BackCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="←"/>
                                <TextBlock Text="{loc:Tr Cmd_Back.Label}"/>
                            </StackPanel>
                        </Button>
                        <Button ToolTip.Tip="{loc:Tr Cmd_Next.Label}"
                                Command="{Binding NextCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="→"/>
                                <TextBlock Text="{loc:Tr Cmd_Next.Label}"/>
                            </StackPanel>
                        </Button>

                        <Separator Width="1"/>

                        <Button ToolTip.Tip="{loc:Tr Cmd_PlayPause.Label}"
                                Command="{Binding PlayPauseCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding IsAutoPlay, Converter={StaticResource BoolToPlayPauseTextConverter}}"/>
                                <TextBlock Text="{loc:Tr Cmd_PlayPause.Label}"/>
                            </StackPanel>
                        </Button>

                        <Separator Width="1"/>

                        <Button ToolTip.Tip="{loc:Tr Cmd_ZoomOut.Label}"
                                Command="{Binding ZoomOutCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="−"/>
                                <TextBlock Text="{loc:Tr Cmd_ZoomOut.Label}"/>
                            </StackPanel>
                        </Button>
                        <Button ToolTip.Tip="{loc:Tr Cmd_ZoomIn.Label}"
                                Command="{Binding ZoomInCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="+"/>
                                <TextBlock Text="{loc:Tr Cmd_ZoomIn.Label}"/>
                            </StackPanel>
                        </Button>
                        <Button ToolTip.Tip="{loc:Tr Cmd_ResetZoom.Label}"
                                Command="{Binding ResetZoomCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="↺"/>
                                <TextBlock Text="{loc:Tr Cmd_ResetZoom.Label}"/>
                            </StackPanel>
                        </Button>

                        <Separator Width="1"/>

                        <Button ToolTip.Tip="{loc:Tr Cmd_Rotate.Label}"
                                Command="{Binding RotateCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="⟳"/>
                                <TextBlock Text="{loc:Tr Cmd_Rotate.Label}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- Timeline view -->
        <Border Grid.Row="1"
                Margin="8"
                CornerRadius="12"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.SurfaceBorderBrush}"
                BorderThickness="1"
                Height="{Binding TimelineRowHeight}">
            <controls:TimelineControl x:Name="Timeline"
                                     Margin="8"
                                     IsLocked="{Binding IsAutoPlay}"
                                     ViewModel="{Binding TimelineViewModel}"/>
        </Border>

    </Grid>
</UserControl>
