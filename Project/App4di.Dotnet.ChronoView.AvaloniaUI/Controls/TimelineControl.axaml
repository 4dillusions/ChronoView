<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:App4di.Dotnet.ChronoView.Infrastructure.ViewModel;assembly=App4di.Dotnet.ChronoView.Infrastructure"
             xmlns:conv="clr-namespace:App4di.Dotnet.ChronoView.AvaloniaUI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="140"
             x:Class="App4di.Dotnet.ChronoView.AvaloniaUI.Controls.TimelineControl"
             x:DataType="vm:TimelineViewModel">

    <UserControl.Resources>
        <conv:BoolToCollapseExpandTextConverter x:Key="BoolToCollapseExpandTextConverter"/>
    </UserControl.Resources>


    <Grid x:Name="RootGrid"
          RowDefinitions="30,*,Auto"
          Background="Transparent">

        <!-- Dates and Selected Item Info -->
        <Grid Grid.Row="0"
              Margin="0,4,0,8"
              ColumnDefinitions="Auto,*,Auto,Auto">

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource App.SubtleTextBrush}"
                       Text="{Binding StartDateText}"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedImage}"/>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource App.SubtleTextBrush}"
                       Text="{Binding EndDateText}"/>

            <Button Grid.Column="3"
                    Width="30"
                    Height="24"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Right"
                    Command="{Binding CollapseExpandCommand}">
                <TextBlock FontSize="15"
                           Text="{Binding IsCollapsed, Converter={StaticResource BoolToCollapseExpandTextConverter}}"/>
            </Button>
        </Grid>

        <!-- Timeline -->
        <Border x:Name="TimelineContent"
                Grid.Row="1"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="*,11">

                <!-- Thumbnails -->
                <ScrollViewer x:Name="TimelineScroller"
                              Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ThumbPanel"
                                Orientation="Horizontal"
                                Spacing="0"/>
                </ScrollViewer>

                <!-- Labels -->
                <ScrollViewer x:Name="LabelScroller"
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LabelPanel"
                                Orientation="Horizontal"
                                Spacing="0"/>
                </ScrollViewer>

            </Grid>
        </Border>

    </Grid>
</UserControl>
