<?xml version="1.0" encoding="utf-8"?><root><data name="Nav_About.Content" xml:space="preserve"><value>ℹ️ About</value></data><data name="Nav_Home.Content" xml:space="preserve"><value>🏠 Chrono View</value></data><data name="Nav_Settings.Content" xml:space="preserve"><value>🛠️ Settings</value></data><data name="Cmd_OpenFolder.Label" xml:space="preserve"><value>Open folder</value></data><data name="Cmd_Back.Label" xml:space="preserve"><value>Back</value></data><data name="Cmd_Next.Label" xml:space="preserve"><value>Next</value></data><data name="Cmd_PlayPause.Label" xml:space="preserve"><value>Play / Pause</value></data><data name="Cmd_ZoomOut.Label" xml:space="preserve"><value>Zoom out</value></data><data name="Cmd_ZoomIn.Label" xml:space="preserve"><value>Zoom in</value></data><data name="Cmd_ResetZoom.Label" xml:space="preserve"><value>Reset zoom</value></data><data name="Cmd_Rotate.Label" xml:space="preserve"><value>Rotate</value></data><data name="About_Title.Text" xml:space="preserve"><value>About</value></data><data name="About_Description.Text" xml:space="preserve"><value>ChronoView visualizes JPEG images from a selected folder along a horizontal timeline. Each photo is positioned based on its creation date, allowing you to scroll or zoom through your visual history. The main viewer dynamically updates to display the image corresponding to the center point of the timeline.</value></data><data name="Contacts_Title.Text" xml:space="preserve"><value>Contacts</value></data><data name="Contacts_TechSupport_Title.Text" xml:space="preserve"><value>Technical support</value></data><data name="Contacts_TechSupport_Email.Text" xml:space="preserve"><value>support@4dillusions.com</value></data><data name="Contacts_TechSupport_Description.Text" xml:space="preserve"><value>(technical inquiries about our products)</value></data><data name="Contacts_GeneralInfo_Title.Text" xml:space="preserve"><value>General info</value></data><data name="Contacts_GeneralInfo_Email.Text" xml:space="preserve"><value>info@4dillusions.com</value></data><data name="Contacts_GeneralInfo_Description.Text" xml:space="preserve"><value>(general inquiries)</value></data><data name="Technology_Title.Text" xml:space="preserve"><value>Technology</value></data><data name="Technology_Paragraph1.Text" xml:space="preserve"><value>ChronoView is a compact yet expressive WinUI application designed to explore temporal storytelling through images. It demonstrates modern MVVM architecture, clean C# design, and a focus on responsive, user-friendly interaction.</value></data><data name="Technology_Paragraph2.Text" xml:space="preserve"><value>The project highlights structured thinking, modularity, and clear separation of concerns — from timeline rendering and image navigation to asynchronous data loading and smooth transitions. It offers a balanced showcase of both engineering discipline and aesthetic consideration.</value></data><data name="Technology_Paragraph3.Text" xml:space="preserve"><value>ChronoView was created as a portfolio project to illustrate real-world software design principles within a modern desktop context. The goal is not only to present technical capability but also to convey an appreciation for clarity, user flow, and thoughtful UI/UX craftsmanship.</value></data><data name="Settings_Title.Text" xml:space="preserve"><value>Settings</value></data><data name="Settings_Description.Text" xml:space="preserve"><value>Fine-tune theme, language, window behavior, and image view settings. Except for image format and image search, all settings take effect after restart.</value></data><data name="Settings_Section_App.Text" xml:space="preserve"><value>🎨 Application</value></data><data name="Settings_Section_Window.Text" xml:space="preserve"><value>🪟 Window</value></data><data name="Settings_Section_ImageView.Text" xml:space="preserve"><value>🖼️ Image / View</value></data><data name="Settings_Label_Theme.Text" xml:space="preserve"><value>Theme</value></data><data name="Settings_Label_Language.Text" xml:space="preserve"><value>Language</value></data><data name="Settings_Label_MinWidth.Text" xml:space="preserve"><value>Min width</value></data><data name="Settings_Label_MinHeight.Text" xml:space="preserve"><value>Min height</value></data><data name="Settings_Label_TimelineCollapsed.Text" xml:space="preserve"><value>Timeline collapsed</value></data><data name="Settings_Toggle_TimelineCollapsed.OnContent" xml:space="preserve"><value>Yes</value></data><data name="Settings_Toggle_TimelineCollapsed.OffContent" xml:space="preserve"><value>No</value></data><data name="Settings_Label_ZoomSettings.Text" xml:space="preserve"><value>Zoom settings</value></data><data name="Settings_Zoom_Min.Text" xml:space="preserve"><value>Min</value></data><data name="Settings_Zoom_Max.Text" xml:space="preserve"><value>Max</value></data><data name="Settings_Zoom_Step.Text" xml:space="preserve"><value>Step</value></data><data name="Settings_Label_ImageFormat.Text" xml:space="preserve"><value>Image format</value></data><data name="Settings_Label_RecursiveImageSearch.Text" xml:space="preserve"><value>Recursive image search</value></data><data name="Settings_Toggle_RecursiveImageSearch.OnContent" xml:space="preserve"><value>On</value></data><data name="Settings_Toggle_RecursiveImageSearch.OffContent" xml:space="preserve"><value>Off</value></data><data name="Settings_Button_ResetDefault.Content" xml:space="preserve"><value>Reset to defaults</value></data><data name="Settings_Footer_Copyright.Text" xml:space="preserve"><value>© 2025 4D Illusions</value></data></root>