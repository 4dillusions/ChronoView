	<!-- ABOUT -->
	<data name="About_Title.Text" xml:space="preserve">
	  <value>Névjegy</value>
	</data>

	<data name="About_Description.Text" xml:space="preserve">
	  <value>A ChronoView JPEG képeket jelenít meg egy kiválasztott mappából egy vízszintes idővonal mentén. Minden kép a létrehozás dátuma alapján kerül elhelyezésre, lehetővé téve a vizuális előzmények közötti görgetést és nagyítást. A fő megjelenítő dinamikusan frissül, és mindig az idővonal középpontjához tartozó képet mutatja.</value>
	</data>

