<Page
    x:Class="App4di.Dotnet.ChronoView.WinUI.View.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
        </Grid.RowDefinitions>

        <!-- About -->
        <Border Style="{StaticResource CardStyle}" Grid.Column="0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ℹ️" Style="{StaticResource CardIconStyle}"/>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock x:Uid="About_Title" Style="{StaticResource HeadlineTextStyle}"/>

                    <TextBlock x:Uid="About_Description" Style="{StaticResource SubtleTextStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contact -->
        <Border Style="{StaticResource CardStyle}" Grid.Column="1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="📧" Style="{StaticResource CardIconStyle}"/>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock x:Uid="Contacts_Title" Style="{StaticResource HeadlineTextStyle}"/>

                    <TextBlock x:Uid="Contacts_TechSupport_Title" Style="{StaticResource MainTextStyle}"/>
                    <TextBlock Style="{StaticResource HyperlinkTextStyle}">
                <Hyperlink NavigateUri="mailto:support@4dillusions.com">
                    support@4dillusions.com
                </Hyperlink>
                    </TextBlock>
                    <TextBlock x:Uid="Contacts_TechSupport_Description" Style="{StaticResource SubtleTextStyle}"/>

                    <TextBlock x:Uid="Contacts_GeneralInfo_Title" Style="{StaticResource MainTextStyle}"/>
                    <TextBlock Style="{StaticResource HyperlinkTextStyle}">
                <Hyperlink NavigateUri="mailto:info@4dillusions.com">
                    info@4dillusions.com
                </Hyperlink>
                    </TextBlock>
                    <TextBlock x:Uid="Contacts_GeneralInfo_Description" Style="{StaticResource SubtleTextStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Technology -->
        <Border Style="{StaticResource CardStyle}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🖥️" Style="{StaticResource CardIconStyle}"/>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock x:Uid="Technology_Title" Style="{StaticResource HeadlineTextStyle}"/>

                    <TextBlock x:Uid="Technology_Paragraph1" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" xml:space="preserve"/>
                    <TextBlock x:Uid="Technology_Paragraph2" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" xml:space="preserve"/>
                    <TextBlock x:Uid="Technology_Paragraph3" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" xml:space="preserve"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Style="{StaticResource SubtleTextStyle}" Text="© 2025 4D Illusions"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
