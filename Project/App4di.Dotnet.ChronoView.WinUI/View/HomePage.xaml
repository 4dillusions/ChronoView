<Page
    x:Class="App4di.Dotnet.ChronoView.WinUI.View.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="using:App4di.Dotnet.ChronoView.WinUI.Control"
    xmlns:Helpers="using:App4di.Dotnet.ChronoView.WinUI.Helpers"
    Helpers:HomePageHelper.ViewModel="{x:Bind ViewModel}"
    NavigationCacheMode="Required">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{x:Bind ViewModel.TimelineRowHeight, Mode=OneWay, Converter={StaticResource IntToGridLengthConverter}}"/>
        </Grid.RowDefinitions>

        <!-- Image view -->
        <Border Grid.Row="0" Margin="8" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Image -->
                <ScrollViewer x:Name="ImageScroller" Grid.Row="0" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="10" HorizontalScrollMode="Auto" VerticalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="ImageView" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Source="{x:Bind ViewModel.SelectedImageItem.ImagePath, Mode=OneWay}">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="ImgRotate" Angle="0"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </ScrollViewer>

                <!-- Menu -->
                <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsSticky="True">
                    <AppBarSeparator/>
                    <AppBarButton x:Uid="Cmd_OpenFolder" Icon="OpenFile" Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneWay}"/>
                    <AppBarSeparator/>

                    <AppBarButton x:Uid="Cmd_Back" Icon="Back" Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}"/>
                    <AppBarButton x:Uid="Cmd_Next" Icon="Forward" Command="{x:Bind ViewModel.NextCommand, Mode=OneWay}"/>
                    <AppBarSeparator/>

                    <AppBarButton x:Uid="Cmd_PlayPause" Command="{x:Bind ViewModel.PlayPauseCommand, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator/>

                    <AppBarButton x:Uid="Cmd_ZoomOut" Icon="ZoomOut" Command="{x:Bind ViewModel.ZoomOutCommand, Mode=OneWay}"/>
                    <AppBarButton x:Uid="Cmd_ZoomIn"  Icon="ZoomIn"  Command="{x:Bind ViewModel.ZoomInCommand, Mode=OneWay}"/>
                    <AppBarButton x:Uid="Cmd_ResetZoom" Icon="Zoom" Command="{x:Bind ViewModel.ResetZoomCommand, Mode=OneWay}"/>
                    <AppBarSeparator/>

                    <AppBarButton x:Uid="Cmd_Rotate" Icon="Rotate" Command="{x:Bind ViewModel.RotateCommand, Mode=OneWay}"/>
                </CommandBar>
            </Grid>
        </Border>

        <!-- Timeline view -->
        <Border Grid.Row="1"  Margin="8" CornerRadius="12" Background="{ThemeResource App.SurfaceBrush}" BorderBrush="{ThemeResource App.SurfaceBorderBrush}" BorderThickness="1">
            <Controls:TimelineControl x:Name="Timeline" Margin="8" IsLocked="{x:Bind ViewModel.IsAutoPlay, Mode=OneWay}" ViewModel="{x:Bind ViewModel.TimelineViewModel, Mode=OneWay}"/>
        </Border>
    </Grid>
</Page>
