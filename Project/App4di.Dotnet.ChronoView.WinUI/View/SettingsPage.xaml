<Page
    x:Class="App4di.Dotnet.ChronoView.WinUI.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="12" MaxWidth="820">

                <!-- HEADER CARD -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="⚙️" Style="{StaticResource CardIconStyle}"/>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock x:Uid="Settings_Title"
                                       Style="{StaticResource HeadlineTextStyle}"/>
                            <TextBlock x:Uid="Settings_Description"
                                       Style="{StaticResource SubtleTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- APP SETTINGS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">

                        <StackPanel>
                            <TextBlock x:Uid="Settings_Section_App"
                                       Style="{StaticResource HeadlineTextStyle}"/>
                        </StackPanel>

                        <!-- Theme row -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Uid="Settings_Label_Theme"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding Theme, Mode=TwoWay}" />
                        </Grid>

                        <!-- Language row -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Uid="Settings_Label_Language"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding Language, Mode=TwoWay}" />
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- WINDOW SETTINGS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">

                        <StackPanel>
                            <TextBlock x:Uid="Settings_Section_Window"
                                       Style="{StaticResource HeadlineTextStyle}"/>
                        </StackPanel>

                        <!-- MinWidth -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Uid="Settings_Label_MinWidth"
                                       VerticalAlignment="Center"/>
                            <controls:NumberBox Grid.Column="1"
                                                Minimum="320"
                                                Maximum="7680"
                                                SmallChange="10"
                                                LargeChange="100"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding MinWidth, Mode=TwoWay}"/>
                        </Grid>

                        <!-- MinHeight -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Uid="Settings_Label_MinHeight"
                                       VerticalAlignment="Center"/>
                            <controls:NumberBox Grid.Column="1"
                                                Minimum="240"
                                                Maximum="4320"
                                                SmallChange="10"
                                                LargeChange="100"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding MinHeight, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Timeline collapsed -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Uid="Settings_Label_TimelineCollapsed"
                                       VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1"
                                          x:Uid="Settings_Toggle_TimelineCollapsed"
                                          IsOn="{Binding IsTimelineCollapsed, Mode=TwoWay}"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- IMAGE SETTINGS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">

                        <StackPanel>
                            <TextBlock x:Uid="Settings_Section_ImageView"
                                       Style="{StaticResource HeadlineTextStyle}"/>
                        </StackPanel>

                        <!-- Zoom settings -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Uid="Settings_Label_ZoomSettings"
                                       VerticalAlignment="Top"
                                       Margin="0,6,0,0"/>

                            <StackPanel Grid.Column="1" Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="Settings_Zoom_Min"
                                                   Style="{StaticResource SubtleTextStyle}"/>
                                        <controls:NumberBox Minimum="1"
                                                            Maximum="1000"
                                                            SmallChange="1"
                                                            LargeChange="1"
                                                            SpinButtonPlacementMode="Inline"
                                                            Value="{Binding MinZoom, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Uid="Settings_Zoom_Max"
                                                   Style="{StaticResource SubtleTextStyle}"/>
                                        <controls:NumberBox Minimum="1"
                                                            Maximum="1000"
                                                            SmallChange="1"
                                                            LargeChange="1"
                                                            SpinButtonPlacementMode="Inline"
                                                            Value="{Binding MaxZoom, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock x:Uid="Settings_Zoom_Step"
                                                   Style="{StaticResource SubtleTextStyle}"/>
                                        <controls:NumberBox Minimum="1"
                                                            Maximum="1000"
                                                            SmallChange="1"
                                                            LargeChange="1"
                                                            SpinButtonPlacementMode="Inline"
                                                            Value="{Binding ZoomStep, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- ImageFormat -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Uid="Settings_Label_ImageFormat"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ImageFormats}"
                                      SelectedItem="{Binding ImageFormat, Mode=TwoWay}" />
                        </Grid>

                        <!-- Recursive image search -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Uid="Settings_Label_RecursiveImageSearch"
                                       VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1"
                                          x:Uid="Settings_Toggle_RecursiveImageSearch"
                                          IsOn="{Binding IsRecursiveImageSearch, Mode=TwoWay}"/>
                        </Grid>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,50,0">
                    <Button x:Uid="Settings_Button_ResetDefault"
                            Command="{x:Bind ViewModel.ResetDefaultCommand, Mode=OneWay}" />
                </StackPanel>

                <!-- FOOTER -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,50,0,0">
                    <TextBlock x:Uid="Settings_Footer_Copyright"
                               Style="{StaticResource SubtleTextStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
